{
  "name": "salt-theme-gen",
  "version": "2.0.0",
  "description": "One color → 380+ design tokens. OKLCH-based theme generator with CSS variables, Tailwind config, DTCG export, APCA contrast, tonal palettes, and color blindness simulation. Zero deps, strict TypeScript.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "theme",
    "design-system",
    "oklch",
    "color",
    "generator",
    "typescript",
    "salt",
    "palette",
    "wcag",
    "accessibility",
    "dark-mode",
    "color-science",
    "perceptual",
    "react-native",
    "react",
    "nextjs",
    "platform-agnostic",
    "css-variables",
    "design-tokens",
    "dtcg",
    "tailwind",
    "apca",
    "color-blindness",
    "tonal-palette"
  ],
  "author": "hasansarwer",
  "license": "MIT",
  "homepage": "https://learn.esalt.net/salt-theme-gen",
  "repository": {
    "type": "git",
    "url": "https://github.com/esaltws/salt-theme-gen"
  },
  "bugs": {
    "url": "https://github.com/esaltws/salt-theme-gen/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/esaltws/salt-theme-gen"
  },
  "type": "commonjs",
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}

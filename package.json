{
  "name": "salt-theme-gen",
  "version": "2.0.0-rc.3",
  "description": "One color → complete design system. OKLCH theme generator with CSS, SCSS, Tailwind, shadcn/ui, Panda CSS, DTCG, Figma Variables, Flutter, and SwiftUI output. WCAG + APCA contrast, tonal palettes, color blindness simulation. Zero deps, strict TypeScript.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n')\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "theme",
    "design-system",
    "oklch",
    "color",
    "generator",
    "typescript",
    "salt",
    "palette",
    "wcag",
    "accessibility",
    "dark-mode",
    "color-science",
    "perceptual",
    "react-native",
    "react",
    "nextjs",
    "platform-agnostic",
    "css-variables",
    "design-tokens",
    "dtcg",
    "tailwind",
    "apca",
    "color-blindness",
    "tonal-palette",
    "shadcn",
    "shadcn-ui",
    "scss",
    "sass",
    "panda-css",
    "figma",
    "figma-variables",
    "flutter",
    "dart",
    "swiftui",
    "ios",
    "android",
    "multi-platform"
  ],
  "author": "hasansarwer",
  "license": "MIT",
  "homepage": "https://learn.esalt.net/salt-theme-gen/",
  "repository": {
    "type": "git",
    "url": "https://github.com/esaltws/salt-theme-gen"
  },
  "bugs": {
    "url": "https://github.com/esaltws/salt-theme-gen/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/esaltws/salt-theme-gen"
  },
  "type": "commonjs",
  "bin": {
    "salt-theme-gen": "./dist/cjs/cli.js"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
